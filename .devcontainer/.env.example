# Copy this file to `.env` (gitignored) in the same directory and set DEVELOPER_NAME.
#
# DEVELOPER_NAME is your AWS dev stack instance name: 1-7 lowercase letters/digits,
# starting with a letter. It is the instance you chose when running the
# build_synapse_dev_stack.yml workflow in synapse-ops-dev.
#
# It names your local databases (dev<name>, dev<name>tables) and sets
# org.sagebionetworks.developer / org.sagebionetworks.stack.instance, which key your
# SQS/SNS/S3 dev resources. It must be unique to you.
DEVELOPER_NAME=
