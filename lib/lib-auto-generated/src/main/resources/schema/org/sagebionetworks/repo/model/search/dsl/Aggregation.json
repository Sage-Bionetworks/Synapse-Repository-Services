		"stats": {
			"$ref": "org.sagebionetworks.repo.model.search.dsl.StatsAggregation",
			"description": "A <a href=\"https://docs.opensearch.org/latest/aggregations/metric/stats/\"><code>stats</code></a> metric aggregation."
		},
		"extended_stats": {
			"$ref": "org.sagebionetworks.repo.model.search.dsl.ExtendedStatsAggregation",
