{
	"$schema": "http://json-schema.org/draft-07/schema",
	"$id": "hasMinMaxItems",
	"description": "test for minItems and maxItems",
	"properties": {
		"atLeastOne": {
			"type": "array",
			"minItems": 1
		},
		"atMostTwo": {
			"type": "array",
			"maxItems": 2
		},
		"betweenTwoAndFour": {
			"type": "array",
			"minItems": 2,
			"maxItems": 4
		}
	}
}